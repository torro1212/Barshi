# ══════════════════════════════════════════════════
# Barshi — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ══════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server only — never expose to browser

# ── AI Provider ────────────────────────────────────
# Set ONE of the following. Anthropic is preferred (better quality),
# Google Gemini is the free-tier fallback for local testing.
#
# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
#
# Google Gemini (free tier, no credit card) — aistudio.google.com → API Keys
# GOOGLE_AI_API_KEY=...
# Optional model overrides:
# GEMINI_MODEL_GENERATE=gemini-2.5-flash
# GEMINI_MODEL_FAST=gemini-2.5-flash

# ── Upstash Redis (rate limiting) ──────────────────
# Found in: console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── PostHog (analytics) ────────────────────────────
# Found in: app.posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry (error tracking) ────────────────────────
# Found in: sentry.io → Settings → Client Keys (DSN)
SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ── Resend (email) ─────────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=re_...

# ── App ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SANDBOX_URL=http://localhost:3001       # play.barshi.app in production

# ── Optional: Sentry org/project for source maps ──
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=barshi-web
